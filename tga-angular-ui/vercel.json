{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/tga-angular-ui/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://travel-rag-api-636198143323.asia-southeast1.run.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
