{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/tga-angular-ui/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://empty-nn-travel-rag-api.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
