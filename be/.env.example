# Copy to be/.env and replace the placeholder values.
DATABASE_URL=postgresql://user:password@localhost:5432/travel_rag
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_PARSER_MODEL=deepseek-v4-pro
DEEPSEEK_RETRIEVAL_MODEL=deepseek-v4-flash
DEEPSEEK_ANSWER_MODEL=deepseek-v4-flash
# Backward-compatible model used by ingestion/older scripts.
DEEPSEEK_METADATA_MODEL=deepseek-v4-flash
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# Generate a long random value; do not commit the real secret.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
USER_TIMEZONE=Asia/Ho_Chi_Minh

# Independent thesis evaluator. OPENAI_API_KEY is also accepted as JUDGE_API_KEY.
JUDGE_PROVIDER=openai
OPENAI_API_KEY=replace-later
OPENAI_BASE_URL=https://api.openai.com/v1
DATASET_GENERATOR_MODEL=gpt-5.6-luna
JUDGE_MODEL=gpt-5.6-terra
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_TIMEOUT_SECONDS=90

# Runtime fallback used only when internal retrieval and recovery still leave
# time-sensitive travel requirements uncovered. Stable gaps are queued for
# corpus review without spending a web-search call. Returned URLs and freshness
# metadata are saved to knowledge_gaps and are not automatically ingested.
EXTERNAL_WEB_FALLBACK_ENABLED=true
EXTERNAL_WEB_SEARCH_ONLY_TIME_SENSITIVE=true
EXTERNAL_WEB_RECENT_MAX_AGE_DAYS=90
EXTERNAL_WEB_LIVE_MAX_AGE_HOURS=24
EXTERNAL_WEB_LIVE_CACHE_HOURS=6
EXTERNAL_WEB_MAX_REQUIREMENTS_PER_CALL=3
OPENAI_WEB_SEARCH_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH_REASONING_EFFORT=low
OPENAI_WEB_SEARCH_TIMEOUT_SECONDS=90
OPENAI_WEB_SEARCH_MAX_OUTPUT_TOKENS=4000
EXTERNAL_WEB_MAX_SOURCES=20

# Optional internal cost estimates. Rates are USD per 1M tokens. Keep this
# snapshot aligned with the provider pricing effective date; missing rates
# produce null cost rather than a misleading zero.
LLM_PRICING_EFFECTIVE_DATE=YYYY-MM-DD
LLM_PRICING_SOURCE=provider_pricing_page
LLM_PRICING_USD_PER_1M_JSON={}
# Example shape:
# LLM_PRICING_USD_PER_1M_JSON={"deepseek-v4-flash":{"input":0.14,"cached_input":0.0028,"output":0.28},"deepseek-v4-pro":{"input":0.435,"cached_input":0.003625,"output":0.87},"gpt-5.6-luna":{"input":0,"cached_input":0,"output":0},"gpt-5.6-terra":{"input":0,"cached_input":0,"output":0}}
