# Copy to be/.env and replace the placeholder values.
DATABASE_URL=postgresql://user:password@localhost:5432/travel_rag
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_METADATA_MODEL=deepseek-chat
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# Generate a long random value; do not commit the real secret.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
USER_TIMEZONE=Asia/Ho_Chi_Minh

# Independent thesis evaluator. OPENAI_API_KEY is also accepted as JUDGE_API_KEY.
JUDGE_PROVIDER=openai
OPENAI_API_KEY=replace-later
OPENAI_BASE_URL=https://api.openai.com/v1
DATASET_GENERATOR_MODEL=gpt-5.6-luna
JUDGE_MODEL=gpt-5.6-terra
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_TIMEOUT_SECONDS=90

# Optional internal cost estimates. Rates are USD per 1M tokens. Keep this
# snapshot aligned with the provider pricing effective date; missing rates
# produce null cost rather than a misleading zero.
LLM_PRICING_EFFECTIVE_DATE=YYYY-MM-DD
LLM_PRICING_SOURCE=provider_pricing_page
LLM_PRICING_USD_PER_1M_JSON={}
# Example shape:
# LLM_PRICING_USD_PER_1M_JSON={"deepseek-chat":{"input":0,"cached_input":0,"output":0},"gpt-5.6-luna":{"input":0,"cached_input":0,"output":0},"gpt-5.6-terra":{"input":0,"cached_input":0,"output":0}}
